# Copy this file to `keystore.properties` (same folder) and put your real
# password in it. That file is gitignored and must NEVER be committed.
#
#   cp keystore.properties.example keystore.properties
#
# If this file is missing the release build still works — it just falls back to
# debug signing, which cannot update an existing install.

storeFile=C:/Users/andre/Documents/rdz-release.keystore
keyAlias=rdz

# The password you chose when running keytool. Both are the same unless you
# deliberately set a separate key password.
storePassword=PON_AQUI_TU_CONTRASEÑA
keyPassword=PON_AQUI_TU_CONTRASEÑA
